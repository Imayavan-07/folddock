<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.folder-dock" path="/org/gnome/shell/extensions/folder-dock/">
    <key name="dock-position" type="s">
      <choices>
        <choice value="bottom"/>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'bottom'</default>
      <summary>Where to place the dock on screen (bottom, left, or right)</summary>
    </key>
    <key name="icon-size" type="i">
      <range min="24" max="96"/>
      <default>40</default>
      <summary>Size of app icons</summary>
    </key>
    <key name="bottom-margin" type="i">
      <range min="0" max="48"/>
      <default>4</default>
      <summary>Space between the dock and screen edge</summary>
    </key>
    <key name="background-opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.8</default>
      <summary>Transparency of dock and folder popups</summary>
    </key>
    <key name="autohide-mode" type="s">
      <choices>
        <choice value="never"/>
        <choice value="intellihide"/>
        <choice value="always"/>
      </choices>
      <default>'intellihide'</default>
      <summary>When to hide the dock</summary>
    </key>
    <key name="pressure-threshold" type="i">
      <range min="0" max="300"/>
      <default>100</default>
      <summary>How hard to push your mouse at the edge to show the dock</summary>
    </key>
    <key name="show-running" type="b">
      <default>true</default>
      <summary>Show open apps that are not pinned to the dock</summary>
    </key>
    <key name="show-apps-button" type="b">
      <default>true</default>
      <summary>Show the 9-dot all apps button</summary>
    </key>
    <key name="show-apps-position" type="s">
      <choices>
        <choice value="start"/>
        <choice value="end"/>
      </choices>
      <default>'end'</default>
      <summary>Where the all apps button sits (start or end of dock)</summary>
    </key>
    <key name="launch-animation" type="s">
      <choices>
        <choice value="bounce"/>
        <choice value="zoom"/>
        <choice value="pulse"/>
        <choice value="none"/>
      </choices>
      <default>'bounce'</default>
      <summary>Animation played when clicking an app icon</summary>
    </key>
  </schema>
</schemalist>
